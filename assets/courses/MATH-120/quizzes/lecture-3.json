{"id":"math-120-lecture-3","course":"MATH 120","kind":"lecture","lecture":3,"title":"Matrices & Linear Systems","questions":[{"id":"l3-q1","prompt":"A matrix is introduced as:","choices":["A An array notation packaging systems / linear data.","B A type of fruit.","C Only a 1×1 number forever.","D A trig identity."],"answer":0,"cite":"3.2","explain":"Matrix as mathematical array object."},{"id":"l3-q2","prompt":"You may add matrices only when they have:","choices":["A The same size/shape.","B Different sizes always.","C Only prime dimensions.","D Complex entries exclusively."],"answer":0,"cite":"3.31","explain":"Same-size addition rule."},{"id":"l3-q3","prompt":"Matrix multiplication AB requires:","choices":["A Columns of A equal rows of B (inner dimensions match).","B Any shapes.","C Square only and identical always.","D Addition first."],"answer":0,"cite":"3.37","explain":"Dimension compatibility."},{"id":"l3-q4","prompt":"For 2×2 [[A,B],[C,D]], invertibility requires:","choices":["A AD−BC ≠ 0.","B AD−BC = 0.","C A=0 only.","D B=C=1."],"answer":0,"cite":"3.67","explain":"Determinant nonzero criterion."},{"id":"l3-q5","prompt":"Solving AX=B with invertible A uses:","choices":["A X = A^{-1}B.","B X = B/A entrywise always.","C X = BA only.","D Deleting A."],"answer":0,"cite":"3.73","explain":"Left-multiply by inverse."}]}